# Absolute host paths. They may point to the same directory.
COMFYUI_MODEL_ROOT=/mnt/storage/ai_models/comfyui
COMFYUI_DATA_ROOT=/mnt/storage/ai_models/comfyui

# NVIDIA device index or identifier used by Docker CDI. Public default: 0.
COMFYUI_GPU_DEVICE=0

# Optional for the first base-model image. Required when LoRA Manager needs
# authenticated Civitai downloads. Do not commit the populated .env file.
CIVITAI_API_KEY=
